<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>amazon-creators-mcp</ToolCommandName>
    <PackageId>AmazonCreators.Mcp</PackageId>
    <Version>1.0.0</Version>
    <Authors>Miguel Molina (molidestroyer)</Authors>
    <Description>Model Context Protocol (MCP) server for Amazon Creators API. Allows AI assistants like Claude, Cursor, and Antigravity to fetch prices, search products, and inspect Amazon catalog data over stdio.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/molidestroyer/AmazonCreators.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/molidestroyer/AmazonCreators.Net</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AmazonCreators.Net\AmazonCreators.Net.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

</Project>
